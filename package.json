{
  "name": "halloween_game",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts --dev",
    "dev:client": "node scripts/prepare-assets.mjs && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && node scripts/compress-build.mjs && node scripts/bundle-report.mjs && tsc -p tsconfig.server.json",
    "start": "npm run build && node dist-server/server/index.js",
    "start:dev": "npm run build && node dist-server/server/index.js --dev",
    "test": "node scripts/prepare-assets.mjs && node --test scripts/assets.test.mjs && tsx --test scripts/*.test.ts server/*.test.ts",
    "preview": "vite preview",
    "pretypecheck": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/rubik-wet-paint": "^5.3.0",
    "express": "^5.3.0",
    "phaser": "4.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "private": true,
  "type": "module"
}
